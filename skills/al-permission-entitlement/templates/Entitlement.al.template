// Entitlements - ONLY needed for AppSource apps.
// For per-tenant extensions, state "entitlement not required" and skip.
//
// A permission set says WHAT a user can access.
// An entitlement says WHICH LICENCE TYPES may be granted that permission set.
// Without one, an AppSource app installs but nobody can use it.
//
// VERIFY GUIDs against Microsoft's current published list. Do not copy from
// memory or an old sample - a stale GUID silently grants nothing.

entitlement "<AFFIX> Essential"
{
    Type = PerUserServicePlan;
    Id = '<service-plan-guid-for-bc-essential>';
    ObjectEntitlements = "<AFFIX> All";
}

entitlement "<AFFIX> Premium"
{
    Type = PerUserServicePlan;
    Id = '<service-plan-guid-for-bc-premium>';
    ObjectEntitlements = "<AFFIX> All";
}

// ---------------------------------------------------------------------------
// TEAM MEMBER - the one to get right.
// Granting write access to a Team Member licence is a licensing violation
// AND an AppSource validation failure. Point it at the READ-ONLY set.
// ---------------------------------------------------------------------------
entitlement "<AFFIX> Team Member"
{
    Type = PerUserServicePlan;
    Id = '<service-plan-guid-for-bc-team-member>';
    ObjectEntitlements = "<AFFIX> Read";     // read-only - NOT "<AFFIX> All"
}

// ---------------------------------------------------------------------------
// Other types available:
//   Type = Role;                  for AAD roles, e.g. Delegated Admin
//   Type = PerTenantServicePlan;  for tenant-wide plans
// ---------------------------------------------------------------------------
