// Extend a base report - NEVER duplicate it.
reportextension <ID> "<AFFIX> <BaseReport> Ext" extends "<BaseReport>"
{
    dataset { add(Header) { column(<AFFIX>SpendThreshold; "<AFFIX> Spend Alert Threshold") { } } }   // anchor top-level DataItem
    rendering { layout("<AFFIX><BaseReport>Layout") { Type = RDLC; LayoutFile = './src/Report/<AFFIX><BaseReport>.rdl'; Caption = '<Base Report> (<Publisher>)'; } }
}
