<?xml version="1.0" encoding="utf-8"?>
<!--
  VALIDATED RDL SKELETON - RDL 2016 namespace. Fill ONLY the FILL_ slots and the
  "FILL:" instruction blocks. Do NOT change the Report element, namespaces,
  DataSets, the Tablix structure, page setup, or element ordering.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSets>
    <DataSet Name="DataSet_Result">
      <Query><DataSourceName>DataSource_Result</DataSourceName><CommandText /></Query>
      <Fields>
        <!-- FILL: one Field per dataset column. Name = the AL column name. -->
        <Field Name="FILL_FieldName"><DataField>FILL_FieldName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="TitleBox">
            <CanGrow>true</CanGrow>
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>FILL_Title</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style>
            </TextRun></TextRuns></Paragraph></Paragraphs>
            <Top>0in</Top><Left>0in</Left><Height>0.35in</Height><Width>6in</Width><Style />
          </Textbox>
          <Tablix Name="MainTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>2in</Width></TablixColumn>
                <TablixColumn><Width>2in</Width></TablixColumn>
                <TablixColumn><Width>1.5in</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow><Height>0.3in</Height><TablixCells>
                  <TablixCell><CellContents><Textbox Name="H_Col1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>FILL_Header1</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="H_Col2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>FILL_Header2</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="H_Col3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>FILL_Header3</Value><Style><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
                </TablixCells></TablixRow>
                <TablixRow><Height>0.25in</Height><TablixCells>
                  <TablixCell><CellContents><Textbox Name="D_Col1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!FILL_Field1.Value</Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="D_Col2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!FILL_Field2.Value</Value><Style /></TextRun></TextRuns></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="D_Col3"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!FILL_Field3.Value</Value><Style><TextAlign>Right</TextAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
                </TablixCells></TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
            <TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember><Group Name="DetailsGroup" /></TablixMember></TablixMembers></TablixRowHierarchy>
            <DataSetName>DataSet_Result</DataSetName>
            <Top>0.5in</Top><Left>0in</Left><Height>0.55in</Height><Width>5.5in</Width><Style />
          </Tablix>
        </ReportItems>
        <Height>1.5in</Height><Style />
      </Body>
      <Width>6.5in</Width>
      <Page>
        <PageFooter>
          <Height>0.3in</Height>
          <ReportItems>
            <Textbox Name="PageInfo"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>0.05in</Top><Left>0in</Left><Height>0.2in</Height><Width>2in</Width><Style /></Textbox>
            <Textbox Name="PrintDate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Today()</Value><Style><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>0.05in</Top><Left>4in</Left><Height>0.2in</Height><Width>2in</Width><Style /></Textbox>
          </ReportItems>
          <PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><Style />
        </PageFooter>
        <LeftMargin>0.5in</LeftMargin><RightMargin>0.5in</RightMargin><TopMargin>0.5in</TopMargin><BottomMargin>0.5in</BottomMargin><Style />
      </Page>
    </ReportSection>
  </ReportSections>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
</Report>
